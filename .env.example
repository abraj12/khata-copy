# ==============================================================================
# KHATA APPLICATION ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Single-Shopkeeper Owner Login & Authentication Architecture
# All values here are placeholders. Real secrets are configured in Render/Vercel.
# ==============================================================================

# Application Runtime
NODE_ENV=production
PORT=5000

# Single Owner Credentials
# OWNER_PHONE must be the owner's canonical 10-digit Indian mobile number
OWNER_PHONE=REPLACE_WITH_10_DIGIT_OWNER_PHONE
# OWNER_PASSWORD_HASH must be an Argon2id hash generated via scripts/hash-owner-password
OWNER_PASSWORD_HASH=REPLACE_WITH_REAL_ARGON2ID_HASH

# Neon PostgreSQL Database Connections (with TLS enabled)
# DATABASE_URL_POOLED: Neon pooled PostgreSQL URL for Render runtime & session store
DATABASE_URL_POOLED=postgresql://neondb_owner:REPLACE_WITH_ROTATED_PASSWORD@ep-shy-mud-94919289-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL: Direct Neon PostgreSQL URL for migrations and administrative tasks
DATABASE_URL=postgresql://neondb_owner:REPLACE_WITH_ROTATED_PASSWORD@ep-shy-mud-94919289.us-east-2.aws.neon.tech/neondb?sslmode=require

# Server-Side Session Configuration
# SESSION_SECRET must be at least 32 cryptographically random characters
SESSION_SECRET=REPLACE_WITH_LONG_CRYPTOGRAPHICALLY_RANDOM_SECRET_AT_LEAST_32_BYTES
# 7-day inactivity rolling timeout in milliseconds (7 * 24 * 60 * 60 * 1000 = 604800000)
SESSION_MAX_AGE_MS=604800000
SESSION_COOKIE_NAME=khata_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTP_ONLY=true
SESSION_COOKIE_SAME_SITE=lax

# Frontend Production Origin (Allowed for Credentialed CORS)
FRONTEND_URL=https://khata.algions.in

# Persistent Login Abuse Protection & Lockout Thresholds
# Tier 1: 5 failed attempts in 15 mins -> 15 min temporary lockout
LOGIN_MAX_ATTEMPTS=5
LOGIN_FAILURE_WINDOW_MS=900000
LOGIN_LOCK_DURATION_MS=900000
# Tier 2: 10 failed attempts in 24 hours -> 30 min extended lockout
LOGIN_EXTENDED_THRESHOLD=10
LOGIN_EXTENDED_WINDOW_MS=86400000
LOGIN_EXTENDED_LOCK_DURATION_MS=1800000
# Retention period for login attempt logs
LOGIN_LOG_RETENTION_DAYS=30

# Reverse Proxy Configuration (Render reverse proxy hop count)
TRUST_PROXY=1

# Cloudflare R2 Object Storage (Optional: Product Images & Offline Bill Documents)
# Region is 'auto'. Obtain credentials from Cloudflare Dashboard -> R2 -> Manage R2 API Tokens.
R2_ACCOUNT_ID=REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID
R2_ACCESS_KEY_ID=REPLACE_WITH_R2_API_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=REPLACE_WITH_R2_API_SECRET_ACCESS_KEY
R2_BUCKET_NAME=khata-documents
# Optional direct or custom endpoint (defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com)
# R2_ENDPOINT=https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com

# Optional: Neon Realtime (Explicitly deferred until official SDK GA)
# NEON_REALTIME_URL=https://ep-shy-mud-94919289.realtime.us-east-2.aws.neon.tech/v1
# NEON_REALTIME_SECRET=REPLACE_WITH_ROTATED_NEON_REALTIME_SECRET
