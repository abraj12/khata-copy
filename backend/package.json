{
  "name": "khata-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Khata Owner Login & Authentication Backend",
  "main": "dist/index.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "migrate": "tsx scripts/migrate.ts",
    "preflight:quantity": "tsx scripts/preflight-quantity-check.ts",
    "hash-password": "tsx scripts/hash-owner-password.ts",
