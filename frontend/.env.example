# Public Backend API Base URL
# - In local development: Leave blank or omit (Vite dev server proxies /api to http://localhost:5000)
# - In production (Vercel): Set to your production API endpoint (defaults to https://api-erp.algions.in)
VITE_API_BASE_URL=https://api-erp.algions.in

# Note: Never put database credentials, session secrets, or passwords in frontend env vars!
