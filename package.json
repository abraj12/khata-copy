{
  "name": "khata-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Single-shopkeeper Khata Owner Login & Authentication Application",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm run build:backend && npm run build:frontend",
    "test": "npm --prefix backend test",
    "hash-password": "npm --prefix backend run hash-password"
  },
  "keywords": [
    "khata",
    "authentication",
    "neon",
    "capacitor",
    "argon2id",
    "express-session"
  ],
  "author": "Algions",
  "license": "UNLICENSED",
  "devDependencies": {
    "@esbuild/win32-x64": "^0.21.5",
    "pg-mem": "^3.0.14"
  }
}
