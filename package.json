{
  "name": "khata-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Single-shopkeeper Khata Owner Login & Authentication Application",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "build": "npm run build:backend && npm run build:frontend",
    "test": "npm test --workspace=backend",
    "test:integration": "npm run test:integration --workspace=backend",
    "migrate": "npm run migrate --workspace=backend --",
    "hash-password": "npm run hash-password --workspace=backend",
    "preflight:legacy": "npm run preflight:legacy --workspace=backend"
  },
  "keywords": [
    "khata",
    "authentication",
    "neon",
    "capacitor",
    "argon2id",
    "express-session"
  ],
  "author": "Algions",
  "license": "UNLICENSED",
  "devDependencies": {
    "vitest": "^2.1.9"
  }
}
